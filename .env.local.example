# ===== Clerk (同一个 Application 的 Key，所有 yosvu 站点共用) =====
# 在 https://dashboard.clerk.com/apps/app_3KdwU8D0vy7WG1jA1mOtK6RrOEx 的 API Keys 里复制
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ===== 域名与路由 (Primary 登录中心) =====
# 本站点自己的域名（部署到 Vercel 后改为真实域名）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 用户登录/注册页路径（默认即可）
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_OUT_URL=/

# ===== 管理员开关 =====
# 允许哪些 Clerk User ID 进入 /admin 后台，逗号分隔
CLERK_ADMIN_USER_IDS=
